# Monday.com personal API token (Admin avatar > Developers/API > "My access tokens")
# https://developer.monday.com/api-reference/docs/authentication
MONDAY_API_TOKEN=

# Board IDs (numeric, visible in each board's URL) — fill in after the CSVs are imported.
# Leave blank and the app will look boards up by name at startup instead.
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=

# LLM used for query parsing / NL responses. Set LLM_PROVIDER to "groq" or
# "anthropic" and fill in the matching key below; if LLM_PROVIDER is left
# blank, it defaults to "groq" when GROQ_API_KEY is set, else "anthropic".
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
